# Required for live Gemini 4 Neon, Gemini 4 Carbon, and Gemini Decisions API (gemini-decision-1)
GEMINI_API_KEY=

# Backend configuration
SHERLOCKED_PORT=8787
SHERLOCKED_HOST=0.0.0.0

# Optional: Meta Wearables Device Access Toolkit (Ray-Ban Meta)
# Leave blank to run in fallback iPhone Camera/Mic + Replay mode until Meta Developer portal provisioning is added
META_APP_ID=
META_CLIENT_TOKEN=
META_URL_SCHEME=sherlocked

# Optional: Path to local gated research datasets (CASME II, SAMM, MU3D, DOLOS, Bag of Lies)
RESTRICTED_DATASETS_DIR=
